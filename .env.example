# Local defaults: SQLite remains intact. In Vercel, PostgreSQL is mandatory.
DATABASE_BACKEND=sqlite
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# NEON_MIGRATION_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require
# RELAS_ENV=development

# Required in Preview and Production (no development credentials fallback).
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$SALT$DIGEST
# SESSION_SECRET=

# Optional local-only configuration:
# RELAS_ADMIN_PASSWORD=
# RADAR_DATA_DIR=
# RADAR_PORT=8815
